# WxMap resource file (wxmap.rc)
# ===============================
# Site/install-wide defaults for WxMap. This file is tracked in git and
# should hold values that are correct for most installs.
#
# Overrides, lowest to highest priority:
#   1. This file (wxmap.rc)
#   2. wxmap.local.rc, if present next to this file -- gitignored, for
#      per-checkout overrides. See wxmap.local.rc.example.
#   3. An explicit --rc <file> passed on the command line.
#
# Any key here can also be given a per-node variant that wins automatically
# when running on that node, e.g.:
#   shape_path:            /some/generic/default
#   shape_path_discover:   /discover/nobackup/jardizzo/maps
#   shape_path_dataportal: /explore/.../maps
# (node is one of "discover", "dataportal", or "local" -- see Config.get_node)

# Configuration lookup
# ---------------------
# config_path lists all directories WxMap searches for instances/themes and
# configuration files. config selects the default configuration/theme.

config_path: $install_path/share:$install_path/share/themes:$install_path/share/missions:$install_path/share/examples
config: [wxmap]

config_path_dataportal: /explore/dataportal/applications/GMAO/fluiddev/config/config_dev/share:/explore/dataportal/applications/GMAO/fluiddev/config/config_dev/share/themes:/explore/dataportal/applications/GMAO/fluiddev/config/config_dev/share/missions:/explore/dataportal/applications/GMAO/fluiddev/config/config_dev/share/special:/explore/dataportal/applications/GMAO/fluiddev/config/config_dev/share/examples

# Paths
# -----

shape_path: /discover/nobackup/jardizzo/maps   # installed shapefile database
logo_path:  $install_path/share/files          # logo images for map branding
map_path:   /discover/nobackup/$USER/fluid/map # cache of background map images
track_path: /discover/nobackup/projects/gmao/merra2/data/pub/supplemental/climatestatistics/track  # tropical storm track files
bin_path:   $install_path/bin                  # compiled JSON derived from YAML (used by the WxMap front-end)

shape_path_dataportal: /explore/dataportal/applications/devel/gmao_data_services/static/data-services/wxmaps/maps
map_path_dataportal: /home/$USER/fluid/map
track_path_dataportal: /discover/nobackup/projects/gmao/merra2/pub/supplemental/climatestatistics/track

# GrADS
# -----
# grads_bin is the command used to launch the GrADS binary (path + any
# flags). If launching this fails, WxMap falls back to running "grads"
# resolved from $PATH.

grads_bin: grads
grads_bin_discover:   /discover/nobackup/projects/gmao/share/dasilva/opengrads/Contents/grads
grads_bin_dataportal: /explore/dataportal/applications/GMAO/grads-dev/Contents/grads

# Fonts
# -----

font:  $install_path/share/files/helr45w.ttf   # regular
bfont: $install_path/share/files/helr65w.ttf   # bold
mfont: $install_path/share/files/VeraMono.ttf  # monospace

# Cache key normalization
# ------------------------
# keymap maps the path/file settings above to stable placeholder values so
# the image-cache signature doesn't change just because these settings do.

keymap:
  shape_path: /data/maps
  logo_path: /data/logos
  map_path: /data/maps
  colorbar: cbart.gs
  font: helr45w.ttf
  mfont: VeraMono.ttf
